#!/usr/bin/sh
#
# live-noctalia: noctalia specific setup for livesys
# SPDX-License-Identifier: GPL-3.0-or-later
#

WM=umbriel

sudo bash -c 'cat <<EOF > /etc/greetd/config.toml
[terminal]
vt = next

[default_session]
command = "/usr/bin/noctalia-greeter-session"
user = "greetd"

[initial_session]
command = "'$WM'"
user = "liveuser"
EOF'

mkdir -p /home/liveuser/.local/share/applications
cp /usr/share/applications/liveinst.desktop /home/liveuser/.local/share/applications
sed -i -r -e "s/(NoDisplay=)true/\1false/" -e "s/(Terminal=)false/\1true/" /home/liveuser/.local/share/applications/liveinst.desktop

sed -i -r -e "s/^.*(autostart = \[\"noctalia\").*/\1,\"additional_setup.sh \&\"\]/" /home/liveuser/.config/umbriel/config.toml

cat >> /home/liveuser/.config/umbriel/config.toml <<EOF

[[window_rule]]
# match.app_id = "^org.fedoraproject.AnacondaInstaller$"
match.app_id = "^liveinst$"
default_maximize = true

EOF
