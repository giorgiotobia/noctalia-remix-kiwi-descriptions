#!/usr/bin/sh
#
# live-noctalia: noctalia specific setup for livesys
# SPDX-License-Identifier: GPL-3.0-or-later
#

WM=umbriel

OUTPUT=$(file /sys/class/drm/*/modes | awk -F':' '/ASCII text/ {print $1}' | head -1)
MONITOR=$(echo $OUTPUT | sed -re "s|/sys/class/drm/card[0-9]-(.*)/modes|\1|")
RESOLUTION=$(head -1 $OUTPUT)

if [ ${RESOLUTION%x*} -ge 3840 ]; then
SCALE=1.60
elif [ ${RESOLUTION%x*} -ge 2560 ]; then
SCALE=1.25
else
SCALE=1.00
fi

UMBRIEL_OUTPUTS=$(LC_NUMERIC="en_US.UTF-8" echo "\n[output.\"$MONITOR\"]\nscale\ =\ $SCALE\n")

sed -i -e '/# Outputs$/a\'"$UMBRIEL_OUTPUTS"'' /home/liveuser/.config/umbriel/config.toml

sudo bash -c 'cat <<EOF > /etc/greetd/config.toml
[terminal]
vt = next

[default_session]
command = "/usr/bin/noctalia-greeter-session"
user = "greetd"

[initial_session]
command = "'$WM'"
user = "liveuser"
EOF'

mkdir -p /home/liveuser/.local/share/applications
cp /usr/share/applications/liveinst.desktop /home/liveuser/.local/share/applications
sed -i -r -e "s/(NoDisplay=)true/\1false/" -e "s/(Terminal=)false/\1true/" /home/liveuser/.local/share/applications/liveinst.desktop

sed -i -r -e "s/^.*(autostart = \[\"noctalia\").*/\1,\"additional_setup.sh \&\"\]/" -e "/\[general\]/a\show_cheatsheet = true" /home/liveuser/.config/umbriel/config.toml

# sed -i -r -e "/(theme = \").*/\1noctalia\"/" /home/liveuser/.config/strata/settings.toml

cat >> /home/liveuser/.config/umbriel/config.toml <<EOF

[[window_rule]]
# match.app_id = "^org.fedoraproject.AnacondaInstaller$"
match.app_id = "^liveinst$"
default_maximize = true

EOF

IS_VIRTUAL=$(systemd-detect-virt)

if [ "$IS_VIRTUAL" == "kvm" ]; then
sed -i -e '/\[appearance.blur\]/a\enabled = false' /home/liveuser/.config/umbriel/config.toml
fi
